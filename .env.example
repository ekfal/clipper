# Copy to .env and fill in what you need. Nothing here is required to render a
# clip: with an empty file the copy degrades to transcript-derived text and the
# download is capped at whatever YouTube serves an unauthenticated request.
#
#   cp .env.example .env
#   python preflight.py     # says which of these are actually missing
#
# .env is gitignored. Do not commit it, and do not paste a filled-in copy into
# a chat with an agent.

# --- copy generation -------------------------------------------------------
# 9Router (OpenAI-compatible). Without a key, metadata.py falls back to copy
# derived from the transcript: the clip still renders, the title is weaker.
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_MODEL=

# --- download --------------------------------------------------------------
# Netscape-format cookies.txt. Without it YouTube serves 360p at best, which
# looks soft once a 9:16 crop is upscaled to 1080x1920. See fetch.py for how to
# export one, and for the PO-token provider a flagged VPS also needs.
CLIPPER_YT_COOKIES=cookies.txt
# Ceiling on what to fetch. 1440 is the default: better than 1080p through a
# crop, without the file size 2160p brings.
CLIPPER_MAX_HEIGHT=1440
# Refuse a source longer or larger than this before downloading it.
CLIPPER_MAX_SOURCE_SECONDS=3600
CLIPPER_MAX_SOURCE_GB=2

# --- render ----------------------------------------------------------------
# Point this at a specific binary when ffmpeg is not on PATH.
CLIPPER_FFMPEG=ffmpeg
# cover crops the source to fill 9:16 (default). fill and fit keep a band, and
# suit a landscape source where covering means a hard zoom.
CLIPPER_FRAME_MODE=cover
# phrase (default) or karaoke.
CLIPPER_CAPTION_STYLE=phrase
# boxes (default, one white box per line) or card.
CLIPPER_HOOK_STYLE=boxes
# small is the default and fits an hourly run on a small box. medium is more
# accurate and roughly three times slower.
CLIPPER_WHISPER_MODEL=small
# Music. Drop tracks in this folder; see bgm.py for how a mood is matched.
CLIPPER_BGM_DIR=bgm

# --- job.py ----------------------------------------------------------------
# One job at a time per host. A request arriving while another is in flight
# exits 3 with {"busy": true} rather than queueing.
CLIPPER_JOB_OUT=jobs
CLIPPER_JOB_LOCK_WAIT=0

# --- failure reports -------------------------------------------------------
# With both set, a failed job files a GitHub issue with the diagnostics, so it
# can be looked at without shell access to the box. Secrets are stripped, and
# report.py's self-check asserts that.
CLIPPER_GITHUB_TOKEN=
CLIPPER_GITHUB_REPO=

# --- the rest of the pipeline (not needed for clip testing) -----------------
# Clippo session, YouTube upload tokens, the accounts dashboard.
CLIPPO_SESSION=clippo_session.json
CLIPPER_TOKEN_DIR=tokens
CLIPPER_DB=clipper.sqlite
CLIPPER_DASH_HOST=127.0.0.1
CLIPPER_DASH_PORT=8000

# --- tuning knobs, defaults are in the module that reads them --------------
# Listed so nothing is hidden, but you rarely set these. Each one has a default
# next to a comment explaining the number, which is the better place to read.
#
#   edit.py      CLIPPER_CODEC CLIPPER_PRESET CLIPPER_BITRATE CLIPPER_FPS
#                CLIPPER_THREADS CLIPPER_HOOK_SECONDS CLIPPER_CAPTION_PLACE
#                CLIPPER_BG_DIR CLIPPER_OUT
#   fetch.py     CLIPPER_MEDIA CLIPPER_MEDIA_TTL_HOURS
#   job.py       CLIPPER_JOB_LOCK
#   pipeline.py  CLIPPER_TASKS_PER_RUN CLIPPER_CLIPS_PER_TASK
#                CLIPPER_PUBLISH_PLATFORMS CLIPPER_STALE_MINUTES
#   ai.py        NINEROUTER_RETRIES NINEROUTER_BACKOFF
#   report.py    CLIPPER_REPORT_DIR
#   upload_youtube.py  CLIPPER_YT_ACCOUNT
